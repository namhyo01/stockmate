# 이 파일을 .env로 복사해서 값을 채우세요: cp .env.example .env
# .env는 git에 올라가지 않습니다.

# DB 위치 (기본값: data/stockmate.db)
# DB_PATH=

# 2단계: 한국투자증권 Open API (https://apiportal.koreainvestment.com)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# 4단계: 공시 수집 (AI 분석은 API 키 없이 Claude Code 구독으로 한다)
DART_API_KEY=

# 5단계: 텔레그램 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 웹 대시보드 로그인 비밀번호 (서버에 올릴 때 필수, 사용자 이름은 아무거나)
WEB_PASSWORD=
# Claude Code 실행 파일 경로 (PATH에 없을 때만)
# CLAUDE_BIN=/home/ubuntu/.local/bin/claude
